# Neon Postgres connection string (provisioned via the Vercel <-> Neon integration)
DATABASE_URL=

# NextAuth v5 — generate with `npx auth secret`
AUTH_SECRET=

# Only needed in production when not deployed on Vercel
# AUTH_TRUST_HOST=true

# Only needed when running `npm run seed:admin` to bootstrap the first admin account
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=
